# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Runtime data.
#
# data/ holds the scientific source of truth (§24.3) for a live run: raw blobs,
# the append-only event store and derived tables. It is deliberately NOT
# committed — a study is released through `marketlab export release`, which
# produces a signed, hash-verified bundle under data/releases/.
#
# data/fixtures/ IS committed: it is what makes the synthetic slice reproducible
# from a clean checkout (§32 "données synthétiques fournies").
# ---------------------------------------------------------------------------
data/*
!data/fixtures/
!data/.gitkeep

# Secrets — never committed (§11.4)
.env
*.key
secrets.yaml

# OS
.DS_Store
Thumbs.db
desktop.ini
